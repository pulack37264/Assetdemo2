# Copy to .env and set your values. App uses Microsoft SQL Server by default.

NODE_ENV=production
PORT=3010
HOST=192.168.216.27
# Admin login (JWT). Required in production: set a strong JWT_SECRET.
JWT_SECRET=change-me-in-production
# Optional: seed one admin on first run if Admins table is empty
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Microsoft SQL Server
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_NAME=AssetManagement
DB_ENCRYPT=false

# Optional: email notifications when an asset is assigned to an employee
# If not set, assignment still works but no email is sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=IT Assets <noreply@yourcompany.com>
CORS_ORIGIN=https://yourdomain.com



